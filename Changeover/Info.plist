<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUFeedURL</key>
	<string>$(SU_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SU_PUBLIC_ED_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- #0110 — once a day, and only while no disc is being ripped.
	     86400 is also Sparkle's own default, so this key changes nothing
	     today; it is here because the interval is now load-bearing rather
	     than incidental. UpdateGate refuses a check that lands during a
	     rip, and Sparkle treats a refusal as a completed check: it stamps
	     lastUpdateCheckDate and reschedules a full interval from then. So
	     the interval decides how long an interrupted check waits, and a
	     silent change to Sparkle's default would change that with it. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Changeover needs to use the DVD drive so it can eject a disc for you when it has finished copying it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Changeover uses your local network so Macs, iPhones and iPads in your home can see the disc, choose what to rip, and watch progress.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_changeover._tcp</string>
	</array>
</dict>
</plist>
